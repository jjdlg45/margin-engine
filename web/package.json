{
  "name": "margin-engine-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "e2e": "playwright test",
    "gen-types": "json2ts -i public/data/schema.json -o src/types/bundle.ts --additionalProperties false --bannerComment \"/* Generated from schema.json (margin-engine export-web). Do not edit. */\"",
    "review-shots": "node capture-review.mjs",
    "readme-shots": "node capture-readme.mjs"
  },
  "dependencies": {
    "@radix-ui/react-collapsible": "^1.2.1",
    "@radix-ui/react-slider": "^1.6.1",
    "@radix-ui/react-tabs": "^1.2.1",
    "@radix-ui/react-tooltip": "1.4.1",
    "@tanstack/react-query": "^5.106.1",
    "@tanstack/react-table": "^8.20.5",
    "@tanstack/react-virtual": "^3.14.26",
    "react": "18.3.1",
    "react-aria-components": "^1.22.1",
    "react-dom": "18.3.1",
    "react-router-dom": "^6.30.6",
    "recharts": "2.13.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "^1.64.1",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@vitejs/plugin-react": "^5.2.0",
    "autoprefixer": "10.6.2",
    "json-schema-to-typescript": "15.0.3",
    "postcss": "^8.5.32",
    "tailwindcss": "3.4.17",
    "typescript": "5.6.3",
    "vite": "^7.3.7",
    "vitest": "^5.1.0"
  }
}
