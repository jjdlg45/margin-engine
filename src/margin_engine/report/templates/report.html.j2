<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<title>Margin Engine Report</title>
<style>
  body { font-family: "Segoe UI", system-ui, sans-serif; margin: 2rem auto; max-width: 1100px; color: #1a1a1a; line-height: 1.45; }
  h1 { border-bottom: 3px solid #0b5563; padding-bottom: .3rem; }
  h2 { color: #0b5563; margin-top: 2.2rem; border-bottom: 1px solid #ddd; padding-bottom: .2rem; }
  table { border-collapse: collapse; width: 100%; font-size: .85rem; margin: .8rem 0; }
  th, td { border: 1px solid #ccc; padding: .3rem .55rem; text-align: right; }
  th { background: #f0f4f5; text-align: center; }
  td:first-child, th:first-child { text-align: left; }
  .status { font-weight: 600; padding: .1rem .4rem; border-radius: 3px; font-size: .78rem; }
  .ok   { background: #e2f3e5; color: #1d6b2e; }
  .warn { background: #fdf2d9; color: #8a6100; }
  .bad  { background: #fbe4e4; color: #9c2121; }
  .muted { color: #666; font-size: .85rem; }
  .kpi { display: inline-block; margin: .4rem 1.6rem .4rem 0; }
  .kpi .v { font-size: 1.5rem; font-weight: 700; display: block; }
  .note { background: #f6f8f8; border-left: 4px solid #0b5563; padding: .5rem .9rem; margin: .6rem 0; font-size: .88rem; }
</style>
</head>
<body>
<h1>Margin Engine Report</h1>
<p class="muted">Generated {{ manifest.created_utc }} &middot; mapping {{ manifest.mapping_file }} &middot; rules sha {{ manifest.rules_sha256[:12] }}</p>

<h2>Data coverage and reconciliation</h2>
<div>
  <span class="kpi"><span class="v">{{ coverage.n_lines }}</span>ledger lines</span>
  <span class="kpi"><span class="v">{{ coverage.n_observations }}</span>sales observations</span>
  <span class="kpi"><span class="v">${{ coverage.net_revenue }}</span>net invoiced revenue</span>
  <span class="kpi"><span class="v">{{ coverage.missing_cost_revenue_share }}</span>revenue with missing cost</span>
  <span class="kpi"><span class="v">{{ coverage.blank_rows_dropped }}</span>blank input rows dropped</span>
</div>
{% if coverage.library_warnings %}
<p class="muted">Library warnings captured during the run (recorded here and in the manifest, not printed):</p>
<table>
  <tr><th>Category</th><th>Message (counts normalized)</th><th>Occurrences</th></tr>
  {% for w in coverage.library_warnings %}
  <tr><td>{{ w.category }}</td><td style="text-align:left">{{ w.message }}</td><td>{{ w.n_occurrences }}</td></tr>
  {% endfor %}
</table>
{% endif %}
<table>
  <tr><th>Reconciliation check</th><th>Expected ($)</th><th>Actual ($)</th><th>Allocated ($)</th><th>Residual ($)</th><th>Source total ($)</th><th>Status</th></tr>
  {% for c in reconciliation %}
  <tr><td title="{{ c.check_desc }}">{{ c.check }}</td><td>{{ c.expected }}</td><td>{{ c.actual }}</td>
      <td>{{ c.allocated }}</td>
      <td>{{ c.residual }}</td>
      <td>{{ c.source_total }}</td>
      <td><span class="status {{ 'ok' if c.pass else 'bad' }}">{{ 'PASS' if c.pass else 'FAIL' }}</span></td></tr>
  {% endfor %}
</table>
{% if unallocated_settlements %}
<p class="muted">Unallocated settlements (no matching lines in the customer-period group):</p>
<table>
  <tr><th>Customer</th><th>Period</th><th>Program</th><th>Amount ($)</th></tr>
  {% for u in unallocated_settlements %}
  <tr><td>{{ u.customer_id }}</td><td>{{ u.period }}</td><td>{{ u.rebate_program_id }}</td><td>{{ u.amount }}</td></tr>
  {% endfor %}
</table>
{% endif %}
{% if residuals %}
<p class="muted">Visible residuals. Dollars the pipeline keeps at pool level instead of forcing onto lines:</p>
<table>
  <tr><th>Residual</th><th>Amount ($)</th><th>What it is</th><th>Why it is not allocated to lines</th><th>Where it is listed</th></tr>
  {% for r in residuals %}
  <tr><td title="{{ r.residual_desc }}">{{ r.residual }}</td><td>{{ r.amount }}</td>
      <td style="text-align:left">{{ r.what }}</td>
      <td style="text-align:left">{{ r.why }}</td>
      <td style="text-align:left">{{ r.where }}</td></tr>
  {% endfor %}
</table>
{% endif %}
{% for n in notes %}<div class="note">{{ n }}</div>{% endfor %}

<h2>Price waterfall (sale lines, baseline window)</h2>
<table>
  <tr><th>Stage</th><th>Amount ($)</th><th>% of gross list</th><th>Coverage</th></tr>
  {% for s in waterfall %}
  <tr><td>{{ s.stage }}</td><td>{{ s.amount }}</td><td>{{ s.pct_of_list }}</td><td class="muted">{{ s.coverage }}</td></tr>
  {% endfor %}
</table>

<h2>Peer-group dispersion and outliers</h2>
<p>{{ dispersion.n_groups }} peer groups &middot; {{ dispersion.n_data_quality }} data-quality anomalies &middot; {{ dispersion.n_commercial }} commercial pricing outliers (flags never mixed)</p>

<h2>Commercial segments</h2>
<p class="muted">Decision tree on normalized price index, context features only. Bootstrap median ARI: {{ segments.bootstrap_ari }}; recommendation change share: {{ segments.rec_change }}.</p>
<table>
  <tr><th>Segment</th><th>Rule</th><th>Lines</th><th>Customers</th><th>Items</th><th>Median price index</th></tr>
  {% for r in segments.rules %}
  <tr><td>Segment {{ r.display_rank }}</td>
      <td style="text-align:left"><strong>{{ r.name }}</strong><br><span class="muted">{{ r.plain }}</span>
        <details><summary class="muted">How this group is defined</summary>
          <ul class="muted" style="margin:.3rem 0 .3rem 1.1rem">{% for c in r.conditions %}<li>{{ c }}</li>{% endfor %}</ul>
          {% if r.technical_note %}<span class="muted">{{ r.technical_note }}</span>{% endif %}</details></td>
      <td>{{ r.n_lines }}</td><td>{{ r.n_customers }}</td><td>{{ r.n_items }}</td><td>{{ "%.3f"|format(r.median_price_index) }}</td></tr>
  {% endfor %}
</table>

<h2>Price sensitivity (own-price elasticity)</h2>
<table>
  <tr><th>Segment</th><th>IV estimate</th><th>95% CI (AR, weak-IV robust)</th><th>Naive FE-OLS</th><th>First-stage F</th><th>Overid p</th><th>Evidence status</th></tr>
  {% for s in sensitivity %}
  <tr>
    <td>{{ s.segment }}</td>
    <td>{{ "%.3f"|format(s.iv) if s.iv is not none else "-" }}</td>
    <td>{{ "[%.2f, %.2f]"|format(s.ar_ci_low, s.ar_ci_high) if s.ar_ci_low is not none else "-" }}</td>
    <td>{{ "%.3f"|format(s.naive_fe_ols) if s.naive_fe_ols is not none else "-" }}</td>
    <td>{{ "%.0f"|format(s.first_stage_f) if s.first_stage_f is not none else "-" }}</td>
    <td>{{ "%.3f"|format(s.overid_p) if s.overid_p is not none else "-" }}</td>
    <td><span class="status {{ 'ok' if s.status == 'causal_elasticity_supported' else ('warn' if s.status != 'insufficient_data' else 'bad') }}" title="{{ s.status_desc }}">{{ s.status_label }}</span></td>
  </tr>
  {% endfor %}
</table>
<div class="note">The naive estimate is shown to document endogeneity bias; it is never used for decisions. Descriptive elasticities are not causal. Exclusion restrictions are economic assumptions documented in config; no statistical test fully proves them.</div>

<h2>Price guidance</h2>
<table>
  <tr><th>Status</th><th>Customer-item pairs</th><th>Share</th></tr>
  {% for g in guidance_summary %}
  <tr><td title="{{ g.status_desc }}">{{ g.status }}</td><td>{{ g.n }}</td><td>{{ g.share }}</td></tr>
  {% endfor %}
</table>
<p class="muted">Targets are {{ guidance_label }} — historical reference points, not optimal prices, until elasticity support allows optimization.</p>

<h2>Opportunity (three levels, never summed)</h2>
<div>
  <span class="kpi"><span class="v">${{ opportunity.leakage_total }}</span>observed leakage (12m)</span>
  <span class="kpi"><span class="v">${{ opportunity.gross_total }}</span>gross price opportunity (pocket)</span>
  <span class="kpi"><span class="v">${{ opportunity.gross_conservative_total }}</span>conservative variant (pairs below the 25th percentile raised to it)</span>
  <span class="kpi"><span class="v">${{ opportunity.expected_total }}</span>expected contribution change (causal only)</span>
</div>
<p class="muted">{{ opportunity.n_records }} opportunity records; volume treatment: {{ opportunity.treatment_counts }}</p>

<h2>Order and customer economics</h2>
<div>
  <span class="kpi"><span class="v">{{ economics.n_orders }}</span>orders</span>
  <span class="kpi"><span class="v">{{ economics.n_customers }}</span>customers</span>
  <span class="kpi"><span class="v">${{ economics.net_contribution }}</span>contribution (covered basis)</span>
  <span class="kpi"><span class="v">${{ economics.after_activity }}</span>after activity cost (estimated)</span>
</div>
<p class="muted">Sales contribution ${{ economics.sales_contribution }}; linked returns {{ economics.returns_contribution }} (included, shown separately);
activity cost-to-serve ${{ economics.activity_cost }} (config rates, labeled estimated; the base contribution is kept).
{{ economics.pct_revenue_excluded }} of net invoiced revenue is excluded from contribution because cost is unknown.
{{ economics.n_service_flags }} customer(s) carry service-policy flags (separate from pricing).</p>
<h3>Top contributors (after activity cost)</h3>
<table>
  <tr><th>Customer</th><th>Net invoiced revenue</th><th>Sales contrib.</th><th>Returns contrib.</th><th>Contribution</th><th>Activity cost</th><th>After activity</th><th>% revenue excluded</th></tr>
  {% for r in economics.top_customers %}
  <tr><td>{{ r.customer_id }}</td><td>${{ r.net_revenue }}</td><td>${{ r.sales_contribution }}</td><td>{{ r.returns_contribution }}</td>
      <td>${{ r.contribution }}</td><td>${{ r.activity_cost }}</td><td>${{ r.after_activity }}</td><td>{{ r.pct_revenue_excluded }}</td></tr>
  {% endfor %}
</table>
<h3>Bottom contributors (after activity cost)</h3>
<table>
  <tr><th>Customer</th><th>Net invoiced revenue</th><th>Sales contrib.</th><th>Returns contrib.</th><th>Contribution</th><th>Activity cost</th><th>After activity</th><th>% revenue excluded</th></tr>
  {% for r in economics.bottom_customers %}
  <tr><td>{{ r.customer_id }}</td><td>${{ r.net_revenue }}</td><td>${{ r.sales_contribution }}</td><td>{{ r.returns_contribution }}</td>
      <td>${{ r.contribution }}</td><td>${{ r.activity_cost }}</td><td>${{ r.after_activity }}</td><td>{{ r.pct_revenue_excluded }}</td></tr>
  {% endfor %}
</table>

{% if inventory %}
<h2>Inventory costing</h2>
<p class="muted">Method: {{ inventory.method }} (declared cost basis) &middot; {{ inventory.n_sales_costed }} sales costed &middot; COGS ${{ inventory.cogs_total }} &middot; {{ inventory.n_flagged }} line(s) flagged (insufficient receipts / no standard).</p>
{% endif %}
{% if win_curves %}
<h2>Quote win/loss curves</h2>
<table>
  <tr><th>Segment</th><th>Quotes</th><th>Win rate</th><th>Price coefficient</th><th>95% CI</th><th>Negotiation gap</th><th>Status</th></tr>
  {% for w in win_curves %}
  <tr><td>{{ w.segment }}</td><td>{{ w.n_quotes }}</td><td>{{ "%.1f%%"|format(w.win_rate * 100) }}</td>
      <td>{{ "%.2f"|format(w.price_coef) if w.price_coef is not none else "-" }}</td>
      <td>{{ "[%.2f, %.2f]"|format(w.ci_low, w.ci_high) if w.ci_low is not none else "-" }}</td>
      <td>{{ "%.1f%%"|format(w.negotiation_gap * 100) if w.negotiation_gap is not none else "-" }}</td>
      <td><span class="status {{ 'ok' if w.status == 'estimated_win_curve' else ('warn' if w.status == 'insufficient_precision' else 'bad') }}" title="{{ w.status_desc }}">{{ w.status_label }}</span></td></tr>
  {% endfor %}
</table>
{% endif %}
{% if cross_estimates %}
<h2>Cross-price effects (substitution groups)</h2>
<table>
  <tr><th>Group</th><th>Item</th><th>Substitute</th><th>Cross elasticity</th><th>Min first-stage F</th><th>Status</th></tr>
  {% for c in cross_estimates %}
  <tr><td>{{ c.group_id }}</td><td>{{ c.item_a }}</td><td>{{ c.item_b }}</td>
      <td>{{ "%.2f"|format(c.cross_elasticity) if c.cross_elasticity is not none else "-" }}</td>
      <td>{{ "%.0f"|format(c.min_first_stage_f) if c.min_first_stage_f is not none else "-" }}</td>
      <td><span class="status {{ 'ok' if 'causal' in c.status else ('warn' if 'iv_' in c.status else 'bad') }}" title="{{ c.status_desc }}">{{ c.status_label }}</span></td></tr>
  {% endfor %}
</table>
<p class="muted">Cross-price estimates exist only within declared substitution groups and only where identified; unsupported cases are labeled with a reason, never estimated.</p>
{% endif %}

{% if tieout %}
<h2>Books tie-out</h2>
<p class="muted">Engine monthly totals vs the general ledger. Engine COGS covers lines with known cost ({{ tieout.cost_coverage }} of sale/return revenue); returns are recognized when they occur (management view, see methodology). {{ tieout.n_failing }} month-measure(s) outside tolerance.</p>
<table>
  <tr><th>Month</th><th>Measure</th><th>Engine ($)</th><th>GL ($)</th><th>Difference ($)</th><th>Difference (%)</th><th>Status</th></tr>
  {% for r in tieout.rows %}
  <tr><td>{{ r.month }}</td><td>{{ r.measure }}</td><td>{{ r.engine }}</td><td>{{ r.gl }}</td><td>{{ r.diff }}</td>
      <td>{{ "%.3f%%"|format(r.diff_pct) if r.diff_pct is not none else "-" }}</td>
      <td><span class="status {{ 'ok' if r.within_tolerance else 'bad' }}">{{ 'PASS' if r.within_tolerance else 'FLAG' }}</span></td></tr>
  {% endfor %}
</table>
{% endif %}

{% if real_validation %}
<h2>Real-data validation (no planted truth needed)</h2>
<p class="muted">Checks that remain possible on real data: a temporal backtest, placebo tests and rolling-window stability. All informational; none of them gates an evidence status.</p>
<h3>Temporal backtest</h3>
<table>
  <tr><th>Segment</th><th>Model</th><th>Trained elasticity</th><th>Held-out changes</th><th>RMSE with model</th><th>RMSE no-price baseline</th><th>Improvement</th><th>Out-of-sample slope</th></tr>
  {% for b in real_validation.backtest %}
  <tr><td>{{ b.segment }}</td><td>{{ b.model or "-" }}</td>
      <td>{{ "%.3f"|format(b.beta_train) if b.beta_train is not none else "-" }}</td>
      <td>{{ b.n_test_changes }}</td>
      <td>{{ "%.3f"|format(b.rmse_model) if b.rmse_model is not none else "-" }}</td>
      <td>{{ "%.3f"|format(b.rmse_naive) if b.rmse_naive is not none else "-" }}</td>
      <td>{{ "%.1f%%"|format(b.improvement * 100) if b.improvement is not none else "-" }}</td>
      <td>{{ "%.3f"|format(b.beta_out_of_sample) if b.beta_out_of_sample is not none else "-" }}</td></tr>
  {% endfor %}
</table>
<h3>Placebo tests</h3>
<p class="muted">Shuffled instruments: the statistic is the reduced form (instrument to quantity) because the 2SLS ratio concentrates around OLS when the instrument is irrelevant. Placebo p-values should look uniform (share significant near 5%) and the placebo first stage should die; the actual reduced-form p should be small.</p>
<table>
  <tr><th>Segment</th><th>Test</th><th>Draws</th><th>Actual reduced-form p</th><th>Placebo mean</th><th>Placebo 95% band</th><th>Strong first stage (placebo)</th><th>Draws significant</th></tr>
  {% for p in real_validation.placebo %}
  <tr><td>{{ p.segment }}</td><td>{{ p.test }}</td><td>{{ p.n_draws }}</td>
      <td>{{ "%.4f"|format(p.actual) if p.actual is not none else "-" }}</td>
      <td>{{ "%.3f"|format(p.placebo_mean) }}</td>
      <td>[{{ "%.2f"|format(p.placebo_p025) }}, {{ "%.2f"|format(p.placebo_p975) }}]</td>
      <td>{{ "%.0f%%"|format(p.share_strong_first_stage * 100) if p.share_strong_first_stage is not none else "-" }}</td>
      <td>{{ "%.0f%%"|format(p.share_significant * 100) if p.share_significant is not none else "-" }}</td></tr>
  {% endfor %}
</table>
<h3>Rolling-window stability</h3>
{% if real_validation.stab_el %}
<table>
  <tr><th>Segment</th><th>Windows</th><th>FE-OLS min</th><th>FE-OLS max</th><th>SD across windows</th></tr>
  {% for s in real_validation.stab_el %}
  <tr><td>{{ s.segment }}</td><td>{{ s.n_windows }}</td><td>{{ "%.3f"|format(s.beta_min) }}</td><td>{{ "%.3f"|format(s.beta_max) }}</td><td>{{ "%.3f"|format(s.beta_sd) if s.beta_sd is not none else "-" }}</td></tr>
  {% endfor %}
</table>
{% endif %}
{% if real_validation.stab_seg %}
<table>
  <tr><th>Window</th><th>Lines compared</th><th>Segments (window refit)</th><th>ARI vs full sample</th></tr>
  {% for s in real_validation.stab_seg %}
  <tr><td>{{ s.window }}</td><td>{{ s.n_lines }}</td><td>{{ s.n_segments_window }}</td><td>{{ "%.3f"|format(s.ari_vs_full_sample) }}</td></tr>
  {% endfor %}
</table>
{% endif %}
{% endif %}

<h2>Run manifest</h2>
<p class="muted">Software: {% for k, v in manifest.software_versions.items() %}{{ k }} {{ v }}{{ ", " if not loop.last }}{% endfor %}</p>
<p class="muted">Stage timings (s): {% for k, v in manifest.stage_timings_s.items() %}{{ k }}={{ v }}{{ ", " if not loop.last }}{% endfor %}</p>
<p class="muted">Cleaning decisions: {% for k, v in manifest.cleaning_decisions.items() %}{{ k }}={{ v }}{{ ", " if not loop.last }}{% endfor %}</p>
</body>
</html>
